<!-- pages/add-medicine/add-medicine.wxml -->
<view class="page">
  <view class="container no-tab-pb">

    <!-- ========= 选择方式 ========= -->
    <block wx:if="{{step === 'choose'}}">
      <view class="intro-card">
        <view class="intro-icon">💊</view>
        <view class="intro-main">
          <view class="intro-title">录入一盒真实药品</view>
          <view class="intro-desc">
            以手动填写为准，扫码和拍照只做辅助填充。保存前请核对药品名、有效期、数量和使用人。
          </view>
        </view>
      </view>

      <view class="way-card way-manual is-recommended" bindtap="onManualInput">
        <view class="way-left">
          <view class="way-icon" style="background: #e7f2ee; color: #2e7d6a;">✏️</view>
          <view class="way-main">
            <view class="way-title-row">
              <text class="way-title">手动录入</text>
              <text class="tag tag-success">推荐</text>
            </view>
            <view class="way-desc">填写药品基础信息、有效期、数量和存放位置，最准确也最稳定。</view>
          </view>
        </view>
        <view class="way-go"><text class="way-go-text">开始</text><text class="way-go-arrow">›</text></view>
      </view>

      <view class="way-card way-scan" bindtap="onScanAssist">
        <view class="way-left">
          <view class="way-icon" style="background: #e8f4fd; color: #3498db;">📷</view>
          <view class="way-main">
            <view class="way-title-row">
              <text class="way-title">扫码辅助填充</text>
              <text class="tag tag-info">辅助</text>
            </view>
            <view class="way-desc">扫描药盒条码，尝试填充药品名称、规格和厂家，仍需人工核对。</view>
          </view>
        </view>
        <view class="way-go way-go-soft"><text class="way-go-text">扫码</text><text class="way-go-arrow">›</text></view>
      </view>

      <view class="way-card way-ocr" bindtap="onPhotoAssist">
        <view class="way-left">
          <view class="way-icon" style="background: #fff8e1; color: #f39c12;">📸</view>
          <view class="way-main">
            <view class="way-title-row">
              <text class="way-title">拍照辅助填充</text>
              <text class="tag tag-warning">辅助</text>
            </view>
            <view class="way-desc">拍摄生产日期、有效期或批号区域，识别后进入同一张人工确认表单。</view>
          </view>
        </view>
        <view class="way-go way-go-soft"><text class="way-go-text">拍照</text><text class="way-go-arrow">›</text></view>
      </view>

      <view class="light-notice">
        药无忧不提供医疗诊断、疗效判断或用药建议。录入信息只用于家庭库存、有效期和提醒管理。
      </view>
    </block>

    <!-- ========= 统一填写表单 ========= -->
    <block wx:elif="{{step === 'form'}}">
      <view class="top-back" bindtap="onBackToChoose">
        <text class="top-back-arrow">‹</text>
        <text class="top-back-text">返回选择录入方式</text>
      </view>

      <view class="safety-card">
        <view class="safety-item" wx:for="{{safetyNotices}}" wx:key="*this">
          <text class="safety-icon">ℹ️</text>
          <text class="safety-text">{{item}}</text>
        </view>
      </view>

      <view wx:if="{{assistNotice}}" class="assist-card assist-{{assistNotice.type}}">
        <view class="assist-title">{{assistNotice.title}}</view>
        <view class="assist-desc">{{assistNotice.desc}}</view>
      </view>

      <view class="assist-actions">
        <view class="assist-action" bindtap="onScanAssist">📷 扫码辅助填药品信息</view>
        <view class="assist-action" bindtap="onPhotoAssist">📸 拍照辅助填批次信息</view>
      </view>

      <view class="match-card" wx:if="{{matchPreview}}" style="background: {{matchPreview.cardBg}}; color: {{matchPreview.cardFg}};">
        <view class="match-head">
          <text class="match-icon">{{matchPreview.cardIcon}}</text>
          <view class="match-main">
            <view class="match-summary">{{matchPreview.actionText}}</view>
            <view class="match-sub">{{matchPreview.reasonLabel}}</view>
          </view>
        </view>
      </view>

      <view class="card confirm-section">
        <view class="section-title-row">
          <text class="section-title">药品信息</text>
          <text class="section-src">{{sources.medicineSource === 'barcode' ? '扫码辅助' : '手动录入'}}</text>
        </view>

        <view class="cover-field">
          <view class="cover-preview {{draft.medicine.coverImage ? 'has-image' : ''}}" bindtap="onChooseCoverImage">
            <image wx:if="{{draft.medicine.coverImage}}" class="cover-image" src="{{draft.medicine.coverImage}}" mode="aspectFill"></image>
            <view wx:else class="cover-empty">
              <view class="cover-empty-icon">药</view>
              <view class="cover-empty-text">添加药盒照片</view>
            </view>
          </view>
          <view class="cover-main">
            <view class="cover-title">药盒照片</view>
            <view class="cover-desc">用于家人快速认药，不作为医疗判断依据。</view>
            <view class="cover-actions">
              <view class="cover-action-primary" bindtap="onChooseCoverImage">
                {{draft.medicine.coverImage ? '重新选择' : '拍照/相册'}}
              </view>
              <view wx:if="{{draft.medicine.coverImage}}" class="cover-action-ghost" bindtap="onRemoveCoverImage">移除</view>
            </view>
          </view>
        </view>

        <view class="form-field app-form-field {{errorMap.name ? 'has-error' : ''}}">
          <view class="form-label app-form-label"><text class="req app-form-required">*</text>药品名称</view>
          <input class="form-input app-form-input" placeholder="例如：布洛芬缓释胶囊" value="{{draft.medicine.name}}" data-field="name" bindinput="onMedInput" />
          <text wx:if="{{errorMap.name}}" class="form-error app-form-error">{{errorMap.name}}</text>
        </view>

        <view class="form-field app-form-field {{errorMap.specification ? 'has-error' : ''}}">
          <view class="form-label app-form-label"><text class="req app-form-required">*</text>规格</view>
          <input class="form-input app-form-input" placeholder="例如：0.3g × 20粒/盒" value="{{draft.medicine.specification}}" data-field="specification" bindinput="onMedInput" />
          <text wx:if="{{errorMap.specification}}" class="form-error app-form-error">{{errorMap.specification}}</text>
        </view>

        <view class="form-field app-form-field {{errorMap.category ? 'has-error' : ''}}">
          <view class="form-label app-form-label"><text class="req app-form-required">*</text>类别</view>
          <view class="quick-options app-option-row">
            <view
              wx:for="{{categoryOptions}}"
              wx:key="*this"
              class="quick-option app-option-chip {{draft.medicine.category === item && !categoryCustomVisible ? 'is-active app-option-chip-active' : ''}}"
              data-index="{{index}}"
              bindtap="onCategoryQuickTap"
            >{{item}}</view>
            <view class="quick-option app-option-chip quick-option-other app-option-chip-other {{categoryCustomVisible ? 'is-active app-option-chip-active' : ''}}" bindtap="onCategoryOtherTap">其他</view>
          </view>
          <input
            wx:if="{{categoryCustomVisible}}"
            class="form-input app-form-input custom-input"
            placeholder="请输入药品类别，例如：肠胃、皮肤、眼药"
            value="{{draft.medicine.category}}"
            bindinput="onCategoryCustomInput"
          />
          <text wx:if="{{errorMap.category}}" class="form-error app-form-error">{{errorMap.category}}</text>
        </view>

        <view class="form-field app-form-field {{errorMap.targetMemberIds ? 'has-error' : ''}}">
          <view class="form-label app-form-label"><text class="req app-form-required">*</text>使用人</view>
          <view class="quick-options app-option-row">
            <view
              wx:for="{{membersPickerList}}"
              wx:key="key"
              class="quick-option app-option-chip {{memberPickerIdx === index && !memberCustomVisible ? 'is-active app-option-chip-active' : ''}}"
              data-index="{{index}}"
              bindtap="onMemberQuickTap"
            >{{item.label}}</view>
            <view class="quick-option app-option-chip quick-option-other app-option-chip-other {{memberCustomVisible ? 'is-active app-option-chip-active' : ''}}" bindtap="onMemberOtherTap">其他</view>
          </view>
          <input
            wx:if="{{memberCustomVisible}}"
            class="form-input app-form-input custom-input"
            placeholder="请输入使用人，例如：外婆、宝宝、本人"
            value="{{draft.medicine.customTargetMemberName || draft.medicine.targetMemberLabel}}"
            bindinput="onMemberCustomInput"
          />
          <text wx:if="{{errorMap.targetMemberIds}}" class="form-error app-form-error">{{errorMap.targetMemberIds}}</text>
        </view>

        <view class="form-field app-form-field {{errorMap.storageLocation ? 'has-error' : ''}}">
          <view class="form-label app-form-label"><text class="req app-form-required">*</text>存放位置</view>
          <view class="quick-options app-option-row">
            <view
              wx:for="{{locationOptions}}"
              wx:key="*this"
              class="quick-option app-option-chip {{draft.medicine.storageLocation === item && !locationCustomVisible ? 'is-active app-option-chip-active' : ''}}"
              data-index="{{index}}"
              bindtap="onLocationQuickTap"
            >{{item}}</view>
            <view class="quick-option app-option-chip quick-option-other app-option-chip-other {{locationCustomVisible ? 'is-active app-option-chip-active' : ''}}" bindtap="onLocationOtherTap">其他</view>
          </view>
          <input
            wx:if="{{locationCustomVisible}}"
            class="form-input app-form-input custom-input"
            placeholder="请输入存放位置，例如：玄关抽屉、随身包"
            value="{{draft.medicine.storageLocation}}"
            bindinput="onLocationCustomInput"
          />
          <text wx:if="{{errorMap.storageLocation}}" class="form-error app-form-error">{{errorMap.storageLocation}}</text>
        </view>

        <view class="form-field app-form-field">
          <view class="form-label app-form-label">厂家</view>
          <input class="form-input app-form-input" placeholder="可选，例如：某某制药有限公司" value="{{draft.medicine.manufacturer}}" data-field="manufacturer" bindinput="onMedInput" />
        </view>

        <view class="form-field app-form-field">
          <view class="form-label app-form-label">条码</view>
          <input class="form-input app-form-input" placeholder="可选，扫码后会自动填入" value="{{draft.medicine.barcode}}" data-field="barcode" bindinput="onMedInput" />
        </view>
      </view>

      <view class="card confirm-section">
        <view class="section-title-row">
          <text class="section-title">批次库存</text>
          <text class="section-src {{sources.batchSource === 'ocr' ? 'section-src-warn' : 'section-src-manual'}}">
            {{sources.batchSource === 'ocr' ? '拍照辅助' : '手动录入'}}
          </text>
        </view>

        <view class="form-field app-form-field {{errorMap.expireDate ? 'has-error' : ''}}">
          <view class="form-label app-form-label"><text class="req app-form-required">*</text>有效期至</view>
          <picker mode="date" value="{{draft.batch.expireDate}}" bindchange="onExpireDateChange">
            <view class="form-picker app-form-picker">
              <text>{{draft.batch.expireDate || '点击选择有效期'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
          <text wx:if="{{errorMap.expireDate}}" class="form-error app-form-error">{{errorMap.expireDate}}</text>
        </view>

        <view class="form-field-row">
          <view class="form-field app-form-field flex-1 {{errorMap.totalQuantity ? 'has-error' : ''}}">
            <view class="form-label app-form-label"><text class="req app-form-required">*</text>总数量</view>
            <input type="digit" class="form-input app-form-input" placeholder="例如：24" value="{{draft.batch.totalQuantity}}" data-field="totalQuantity" bindinput="onBatchInput" />
            <text wx:if="{{errorMap.totalQuantity}}" class="form-error app-form-error">{{errorMap.totalQuantity}}</text>
          </view>
          <view class="form-field app-form-field flex-1 ml-16 {{errorMap.remainingQuantity ? 'has-error' : ''}}">
            <view class="form-label app-form-label"><text class="req app-form-required">*</text>剩余数量</view>
            <input type="digit" class="form-input app-form-input" placeholder="例如：24" value="{{draft.batch.remainingQuantity}}" data-field="remainingQuantity" bindinput="onBatchInput" />
            <text wx:if="{{errorMap.remainingQuantity}}" class="form-error app-form-error">{{errorMap.remainingQuantity}}</text>
          </view>
        </view>

        <view class="form-field-row">
          <view class="form-field app-form-field flex-1">
            <view class="form-label app-form-label">单位</view>
            <input class="form-input app-form-input" placeholder="片 / 粒 / 支 / 盒" value="{{draft.batch.unit}}" data-field="unit" bindinput="onBatchInput" />
          </view>
          <view class="form-field app-form-field flex-1 ml-16">
            <view class="form-label app-form-label">批号</view>
            <input class="form-input app-form-input" placeholder="可选" value="{{draft.batch.batchNo}}" data-field="batchNo" bindinput="onBatchInput" />
          </view>
        </view>

        <view class="form-field app-form-field">
          <view class="form-label app-form-label">生产日期</view>
          <picker mode="date" value="{{draft.batch.productionDate}}" bindchange="onProdDateChange">
            <view class="form-picker app-form-picker">
              <text>{{draft.batch.productionDate || '可选，点击选择生产日期'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <view class="form-field app-form-field">
          <view class="form-label app-form-label">备注</view>
          <textarea class="form-textarea app-form-textarea" placeholder="可记录有效期在包装哪个位置，或其他核对说明" value="{{draft.batch.imageSourceNote}}" data-field="imageSourceNote" bindinput="onBatchInput" auto-height></textarea>
        </view>
      </view>

      <view class="btn-col">
        <button class="btn btn-ghost btn-block" bindtap="onSaveDraft">暂存草稿</button>
        <button class="btn btn-primary btn-block mt-12" bindtap="onConfirmSave">保存到家庭药箱</button>
      </view>
    </block>

    <!-- ========= 保存成功 ========= -->
    <block wx:elif="{{step === 'success'}}">
      <view class="success-wrap">
        <view class="success-icon-big">✓</view>
        <view class="success-title">保存成功</view>
        <view class="success-sub" wx:if="{{savePreview}}">{{savePreview.actionSummary}}</view>

        <view class="card mt-32" wx:if="{{savePreview}}">
          <view class="section-title-row">
            <text class="section-title">药品主档</text>
            <text class="section-src">{{savePreview.medicineSource}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">药品名</text>
            <text class="result-v text-primary">{{savePreview.finalMedicine.name}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">规格</text>
            <text class="result-v">{{savePreview.finalMedicine.specification}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">使用人</text>
            <text class="result-v">{{savePreview.finalMedicine.targetMemberLabel || '全家备用'}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">存放位置</text>
            <text class="result-v">{{savePreview.finalMedicine.storageLocation}}</text>
          </view>
        </view>

        <view class="card" wx:if="{{savePreview}}">
          <view class="section-title-row">
            <text class="section-title">新增批次</text>
            <text class="section-src">{{savePreview.batchSource}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">批号</text>
            <text class="result-v">{{savePreview.finalBatch.batchNo || '系统生成'}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">有效期</text>
            <text class="result-v">{{savePreview.finalBatch.expireDate}}（{{savePreview.expireDaysText}}）</text>
          </view>
          <view class="result-row">
            <text class="result-k">数量</text>
            <text class="result-v">{{savePreview.finalBatch.remainingQuantity}} / {{savePreview.finalBatch.totalQuantity}} {{savePreview.finalBatch.unit}}</text>
          </view>
          <view class="result-row">
            <text class="result-k">状态</text>
            <text class="tag" style="background: {{savePreview.batchStatusColor}}22; color: {{savePreview.batchStatusColor}}; border: 1rpx solid {{savePreview.batchStatusColor}}33;">
              {{savePreview.batchStatusLabel}}
            </text>
          </view>
        </view>

        <view class="notice-card">
          <view class="notice-title"><text class="notice-icon">ℹ️</text>下一步</view>
          <view class="notice-desc">
            药品已进入家庭药箱。用药提醒会作为下一阶段独立入口补充，不会混在本次库存录入流程里。
          </view>
        </view>

        <view class="btn-col">
          <button class="btn btn-primary btn-block" bindtap="onGoMedicines">查看药箱</button>
          <button class="btn btn-ghost btn-block mt-12" bindtap="onGoDetail">查看药品详情</button>
          <button class="btn btn-ghost btn-block mt-12" bindtap="onAddAnother">继续添加另一盒</button>
        </view>
      </view>
    </block>

    <!-- ===== 无家庭 gate ===== -->
    <block wx:if="{{noFamily}}">
      <view class="no-family-overlay">
        <view class="no-family-card">
          <view class="no-family-icon">{{noEditPermission ? '🔒' : '🏠'}}</view>
          <view class="no-family-title">{{noEditPermission ? '当前为只读成员' : '请先创建家庭药箱'}}</view>
          <view class="no-family-desc">{{noEditPermission ? '请联系家庭管理员开启药品编辑权限。' : '创建家庭后才能开始录入药品、管理有效期和邀请家人。'}}</view>
          <view wx:if="{{!noEditPermission}}" class="no-family-btn" bindtap="goCreateFamily">去创建家庭</view>
          <view wx:else class="no-family-btn" bindtap="onGoMedicines">返回药箱</view>
        </view>
      </view>
    </block>
  </view>
</view>
