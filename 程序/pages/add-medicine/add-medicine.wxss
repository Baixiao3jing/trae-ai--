/* pages/add-medicine/add-medicine.wxss */

/* ================== 顶部小返回 ================== */
.top-back {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx 8rpx 10rpx;
  margin-bottom: 16rpx;
  color: var(--text-light);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--surface);
  border-radius: 100rpx;
  border: 1rpx solid var(--border);
}
.top-back-arrow { font-size: 38rpx; line-height: 1; font-weight: 300; color: var(--primary); }

/* ================== 通用卡片/标题 ================== */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 20rpx;
}

/* ================== 选择入口页（保留原风格）================== */
.intro-card {
  background: var(--gradient-brand);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(46,125,106,0.25);
  position: relative;
  overflow: hidden;
}
.intro-card::after {
  content: '';
  position: absolute;
  top: -80rpx; right: -60rpx;
  width: 260rpx; height: 260rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}
.intro-icon {
  width: 80rpx; height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-card);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  position: relative; z-index: 1;
}
.intro-main { flex: 1; min-width: 0; position: relative; z-index: 1; }
.intro-title { font-size: 32rpx; font-weight: 800; margin-bottom: 6rpx; }
.intro-desc { font-size: 24rpx; line-height: 1.6; opacity: 0.92; }

.way-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.way-card:active { transform: scale(0.99); background: var(--surface-alt); }
.way-scan { border-left: 6rpx solid var(--info); }
.way-ocr  { border-left: 6rpx solid var(--warning); }
.way-manual { border-left: 6rpx solid var(--primary); }
.way-card.is-recommended {
  border-color: #b4d9c9;
  box-shadow: var(--shadow-md);
}
.way-left { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.way-icon {
  width: 92rpx; height: 92rpx;
  border-radius: var(--radius-card);
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}
.way-main { flex: 1; min-width: 0; }
.way-title-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.way-title { font-size: 32rpx; font-weight: 800; color: var(--text); }
.way-desc { font-size: 24rpx; color: var(--text-light); line-height: 1.55; margin-bottom: 12rpx; }
.way-tips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.way-tip {
  font-size: 22rpx; color: var(--text-muted);
  background: var(--surface-alt);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}
.way-go {
  display: flex; align-items: center; gap: 4rpx;
  background: var(--primary);
  color: #fff;
  padding: 14rpx 22rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(46,125,106,0.3);
}
.way-go-soft {
  background: var(--surface-alt);
  color: var(--text);
  box-shadow: none;
  border: 1rpx solid var(--border);
}
.way-go-text { font-size: 26rpx; font-weight: 700; }
.way-go-arrow { font-size: 28rpx; font-weight: 300; }

/* ================== 说明提示卡（保留）================== */
.notice-card {
  margin-top: 16rpx;
  background: var(--gradient-warning);
  border: 1rpx solid #f4e2b8;
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.notice-title {
  display: flex; align-items: center; gap: 10rpx;
  font-size: 28rpx; font-weight: 700;
  color: #b7791f;
  margin-bottom: 10rpx;
}
.notice-icon { font-size: 26rpx; }
.notice-desc { font-size: 24rpx; color: #8a6d3b; line-height: 1.75; }
.notice-border {
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(138,109,59,0.2);
}

/* ================== 模拟扫码 / OCR ================== */
.simulate-scan {
  position: relative;
  height: 360rpx;
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
  border-radius: var(--radius-card);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scan-corner {
  position: absolute;
  width: 48rpx; height: 48rpx;
  border-color: var(--primary);
  border-style: solid;
}
.scan-tl { top: 60rpx; left: 60rpx;  border-width: 8rpx 0 0 8rpx; border-radius: 12rpx 0 0 0; }
.scan-tr { top: 60rpx; right: 60rpx; border-width: 8rpx 8rpx 0 0; border-radius: 0 12rpx 0 0; }
.scan-bl { bottom: 60rpx; left: 60rpx;  border-width: 0 0 8rpx 8rpx; border-radius: 0 0 0 12rpx; }
.scan-br { bottom: 60rpx; right: 60rpx; border-width: 0 8rpx 8rpx 0; border-radius: 0 0 12rpx 0; }
.scan-line {
  position: absolute;
  left: 80rpx; right: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--primary-light), transparent);
  box-shadow: 0 0 20rpx rgba(77,182,157,0.6);
  animation: scan-move 2.2s ease-in-out infinite;
}
@keyframes scan-move {
  0%   { top: 80rpx; opacity: 0.3; }
  20%  { opacity: 1; }
  100% { top: calc(100% - 80rpx); opacity: 0.3; }
}
.scan-hint {
  position: absolute;
  bottom: 24rpx; left: 0; right: 0;
  text-align: center;
  color: #cbd5e1;
  font-size: 22rpx;
  font-weight: 600;
}

/* OCR 场景顶部 */
.ocr-scan {
  background: linear-gradient(135deg, var(--info-bg), #f5fbff);
  border: 1rpx dashed #9ec9eb;
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
}
.ocr-scan-title {
  font-size: 28rpx; font-weight: 700; color: #1e5b8a;
  margin-bottom: 10rpx;
}
.ocr-scan-desc {
  font-size: 24rpx; color: #38698c; line-height: 1.6;
}

/* 模拟选项列表 */
.mock-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.mock-item {
  background: var(--surface-alt);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 18rpx 20rpx;
  transition: all 0.15s ease;
}
.mock-item.is-active {
  background: #eaf4f0;
  border-color: var(--primary);
  box-shadow: 0 4rpx 14rpx rgba(46,125,106,0.15);
}
.mock-item-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.mock-item-icon {
  width: 60rpx; height: 60rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
}
.mock-item-main { flex: 1; min-width: 0; }
.mock-item-name {
  font-size: 28rpx; font-weight: 700; color: var(--text);
  margin-bottom: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mock-item-code { font-size: 22rpx; color: var(--text-light); }
.mock-item-check {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff;
  background: var(--surface);
  flex-shrink: 0;
}
.mock-item.is-active .mock-item-check {
  background: var(--primary);
  border-color: var(--primary);
}
.mock-item-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
  padding-left: 74rpx;
}
.tag-sm {
  font-size: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: 100rpx;
  background: #e6f2ec;
  color: var(--primary);
  font-weight: 600;
}
.tag-sm.tag-muted { background: var(--surface-alt); color: var(--text-light); }

/* ================== 结果卡 ================== */
.result-card { border-top: 6rpx solid var(--primary); }
.result-title {
  display: flex; align-items: center; gap: 10rpx;
  font-size: 30rpx; font-weight: 800; color: var(--text);
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--border);
}
.result-title-icon { font-size: 30rpx; }
.result-confidence {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 700;
}
.result-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--surface-alt);
}
.result-row:last-child { border-bottom: none; }
.result-k {
  width: 180rpx;
  flex-shrink: 0;
  color: var(--text-light);
  font-size: 24rpx;
  font-weight: 600;
  padding-top: 2rpx;
}
.result-v {
  flex: 1;
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-all;
}
.low-note {
  background: #fff8e1;
  border: 1rpx dashed #e4b963;
  color: #8a6317;
  border-radius: var(--radius);
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

/* ================== 失败卡 ================== */
.fail-card {
  text-align: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
  border: 1rpx solid #f2c3c3;
}
.fail-icon { font-size: 72rpx; margin-bottom: 10rpx; }
.fail-title {
  font-size: 34rpx; font-weight: 800; color: #c0392b;
  margin-bottom: 10rpx;
}
.fail-desc {
  font-size: 26rpx; line-height: 1.7; color: #8a4031;
  padding: 0 10rpx;
}

/* ================== 按钮通用 ================== */
.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.btn-col {
  margin: 28rpx 0 40rpx;
}
.btn {
  border-radius: 100rpx !important;
  font-weight: 700 !important;
  font-size: 28rpx !important;
  padding: 0 36rpx !important;
  line-height: 86rpx !important;
  height: 86rpx !important;
  transition: all 0.15s ease;
  border: none !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.btn::after { border: none !important; }
.btn-primary {
  background: var(--gradient-primary-action);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(46,125,106,0.3);
}
.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(46,125,106,0.25);
}
.btn-ghost {
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border) !important;
}
.btn-ghost:active { background: var(--surface-alt); }
.btn-disabled {
  background: var(--surface-alt) !important;
  color: var(--text-light) !important;
  border-color: var(--border) !important;
  box-shadow: none !important;
}
.btn-block {
  width: 100% !important;
  display: flex !important;
}

/* ================== 安全提示 & 匹配预览 ================== */
.safety-card {
  background: #eef6f3;
  border: 1rpx solid #c9e3d6;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.safety-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #1e5140;
  font-weight: 600;
}
.safety-icon { flex-shrink: 0; font-size: 26rpx; }
.safety-text { flex: 1; }

.match-card {
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-weight: 700;
  box-shadow: var(--shadow-sm);
}
.match-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.match-icon { font-size: 40rpx; }
.match-main { flex: 1; min-width: 0; }
.match-summary { font-size: 28rpx; margin-bottom: 4rpx; }
.match-sub { font-size: 22rpx; opacity: 0.85; font-weight: 600; }

/* ================== 确认页 Section ================== */
.confirm-section .section-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--border);
}
.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}
.section-src {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary);
  background: #e6f2ec;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}
.section-src-warn { color: #a6791a; background: #fff3d0; }
.section-src-manual { color: #444; background: #eee; }

.cover-field {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  background: var(--gradient-brand-soft);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
}
.cover-preview {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx dashed #b4d9c9;
  overflow: hidden;
}
.cover-preview.has-image {
  border-style: solid;
  border-color: #c9ded4;
}
.cover-image {
  width: 100%;
  height: 100%;
  display: block;
}
.cover-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--primary);
}
.cover-empty-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}
.cover-empty-text {
  font-size: 20rpx;
  font-weight: 700;
}
.cover-main {
  flex: 1;
  min-width: 0;
}
.cover-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 6rpx;
}
.cover-desc {
  font-size: 23rpx;
  color: var(--text-light);
  line-height: 1.5;
  margin-bottom: 14rpx;
}
.cover-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cover-action-primary,
.cover-action-ghost {
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.cover-action-primary {
  background: var(--primary);
  color: #ffffff;
}
.cover-action-ghost {
  background: #ffffff;
  color: var(--text-light);
  border: 1rpx solid var(--border);
}

.form-field {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 24rpx;
  color: var(--text-light);
  font-weight: 700;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.req { color: #e74c3c; font-size: 26rpx; font-weight: 700; }
.form-input,
.form-picker,
.form-textarea {
  background: var(--surface-alt);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text);
  transition: all 0.15s ease;
  width: 100%;
  box-sizing: border-box;
}
.form-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
}
.form-textarea {
  min-height: 120rpx;
  padding: 18rpx 22rpx;
  line-height: 1.5;
}
.form-picker {
  min-height: 88rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-arrow {
  font-size: 32rpx;
  color: var(--text-light);
  font-weight: 300;
}
.form-field.has-error .form-input,
.form-field.has-error .form-picker,
.form-field.has-error .form-textarea,
.form-field.has-error .quick-option {
  border-color: #e74c3c;
  background: #fff5f5;
}
.form-error {
  display: block;
  margin-top: 8rpx;
  padding-left: 8rpx;
  font-size: 22rpx;
  color: #c0392b;
  font-weight: 700;
}
.form-field-row {
  display: flex;
  align-items: stretch;
  margin-bottom: 18rpx;
}
.flex-1 { flex: 1; min-width: 0; }
.ml-16 { margin-left: 16rpx; }

.quick-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.quick-option {
  min-height: 68rpx;
  max-width: 100%;
  padding: 0 22rpx;
  border-radius: 100rpx;
  border: 2rpx solid var(--border);
  background: var(--surface-alt);
  color: var(--text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 68rpx;
  box-sizing: border-box;
  word-break: break-all;
}
.quick-option.is-active {
  border-color: var(--primary);
  background: #e6f2ec;
  color: var(--primary);
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 106, 0.12);
}
.quick-option-other {
  background: #fffdf6;
  border-style: dashed;
  color: #8a6317;
}
.custom-input {
  margin-top: 14rpx;
  background: #fff;
  border-color: #b4d9c9;
}

.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-12 { margin-bottom: 12rpx; }
.text-sm { font-size: 22rpx; }
.text-primary { color: var(--primary); font-weight: 700; }
.text-muted { color: var(--text-light); }
.text-danger { color: #c0392b; }
.text-warning { color: #f39c12; }

/* 批次元信息 */
.batch-meta-card {
  background: var(--gradient-brand-soft);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 16rpx 20rpx;
}
.batch-meta-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.batch-meta-k {
  font-size: 24rpx;
  color: var(--text-light);
  font-weight: 700;
  width: 140rpx;
  flex-shrink: 0;
}
.batch-meta-v {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
  font-weight: 600;
}

/* ================== 成功页 ================== */
.success-wrap {
  padding-top: 20rpx;
}
.success-icon-big {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--success), #2ecc71);
  color: #fff;
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx auto 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(39,174,96,0.3);
}
.success-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 10rpx;
}
.success-sub {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.6;
  padding: 0 20rpx 20rpx;
  font-weight: 600;
}

/* ---------- 第六阶段：无家庭 gate ---------- */
.no-family-overlay {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(245, 249, 247, 0.98);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.no-family-card {
  background: #ffffff;
  border: 2rpx dashed #b4d9c9;
  border-radius: var(--radius-card);
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  width: 100%;
  box-shadow: 0 16rpx 40rpx rgba(46, 125, 106, 0.08);
}
.no-family-icon {
  font-size: 80rpx;
  margin-bottom: 14rpx;
}
.no-family-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 10rpx;
}
.no-family-desc {
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.7;
  margin-bottom: 32rpx;
  padding: 0 16rpx;
}
.no-family-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: var(--gradient-primary-action);
  color: #fff;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(46, 125, 106, 0.25);
}
.no-family-btn:active { transform: scale(0.98); }

/* ================== 新流程新增样式 ================== */
/* choose 页 浅色提示（替换原来的大 AI 说明卡） */
.light-notice {
  margin-top: 8rpx;
  background: #f3f9f6;
  border: 1rpx dashed #b4d9c9;
  border-radius: var(--radius);
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #3e6b5a;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.assist-card {
  border-radius: var(--radius-card);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border);
}
.assist-success {
  background: var(--gradient-success);
  border-color: #b4ddc7;
}
.assist-warning {
  background: var(--gradient-warning);
  border-color: #f0d49c;
}
.assist-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 6rpx;
}
.assist-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.65;
}
.assist-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.assist-action {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 18rpx 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text);
  font-weight: 700;
  box-shadow: var(--shadow-sm);
}
.assist-action:active {
  background: var(--surface-alt);
  transform: scale(0.98);
}

/* warn-card：条码未命中 / 未选图片等提示 */
.warn-card {
  background: linear-gradient(180deg, var(--warning-bg) 0%, #ffffff 100%);
  border: 1rpx solid #ecd28a;
  text-align: center;
  padding: 40rpx 28rpx;
}
.warn-icon { font-size: 72rpx; margin-bottom: 10rpx; }
.warn-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #8a6317;
  margin-bottom: 8rpx;
}
.warn-sub {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8a6d3b;
  padding: 0 10rpx;
}
.code-box {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: #fffbe8;
  border: 1rpx dashed #e2c46c;
  color: #5d470a;
  font-weight: 800;
  font-size: 28rpx;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

/* photo card / image preview */
.photo-card .card-title { text-align: left; }
.photo-preview-box {
  width: 100%;
  background: #f5f8f7;
  border: 2rpx dashed #cde0d6;
  border-radius: var(--radius);
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  min-height: 320rpx;
}
.photo-preview-box.photo-small {
  min-height: 200rpx;
  padding: 12rpx;
}
.photo-preview {
  width: 100%;
  height: 100%;
  min-height: 280rpx;
  max-height: 600rpx;
  border-radius: 12rpx;
  background: #000;
}
.photo-preview-box.photo-small .photo-preview { min-height: 176rpx; max-height: 300rpx; }
.photo-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  background: #eaf5ee;
  border: 1rpx solid #b7d9c5;
  border-radius: var(--radius);
  color: #2c614e;
  font-size: 24rpx;
  line-height: 1.65;
  font-weight: 600;
}
.mb-16 { margin-bottom: 16rpx; }
