<!--pages/elder/elder.wxml  第六阶段：三态切换-->
<view class="elder-page">
  <!-- 顶部问候 -->
  <view class="elder-hero">
    <view class="elder-hero-bg"></view>
    <view class="elder-hero-inner">
      <view class="elder-top">
        <view class="elder-call" bindtap="onCallFamily">📞 联系家人</view>
      </view>
      <view class="elder-greet">{{headerTitle}}</view>
      <view class="elder-date">{{headerSubtitle}} · {{today}}</view>
      <view class="elder-progress">
        <view class="elder-progress-left">
          <text class="elder-progress-num">{{pendingCount}}</text>
          <text class="elder-progress-label">项待服用</text>
        </view>
        <view class="elder-progress-right" wx:if="{{completedCount > 0}}">
          <text class="elder-progress-num done">{{completedCount}}</text>
          <text class="elder-progress-label">项已完成</text>
        </view>
        <view class="elder-progress-right" wx:if="{{skippedCount > 0}}">
          <text class="elder-progress-num skip">{{skippedCount}}</text>
          <text class="elder-progress-label">项已跳过</text>
        </view>
      </view>
    </view>
  </view>

  <view class="elder-container">

    <!-- ===== 阶段 1：无家庭 ===== -->
    <block wx:if="{{stage === 'noFamily'}}">
      <view class="elder-empty elder-empty-big">
        <view class="elder-empty-icon">🏠</view>
        <view class="elder-empty-title">请先创建家庭药箱</view>
        <view class="elder-empty-desc">创建家庭后，管理员可以为老人添加用药提醒。</view>
        <view class="elder-empty-btn" bindtap="goCreateFamily">去创建家庭</view>
      </view>
    </block>

    <!-- ===== 阶段 2：有家庭但无提醒 ===== -->
    <block wx:elif="{{stage === 'noReminders'}}">
      <view class="elder-empty elder-empty-big">
        <view class="elder-empty-icon">🌿</view>
        <view class="elder-empty-title">今天暂时没有服药计划</view>
        <view class="elder-empty-desc">请先在药箱中录入药品，或在添加药品时选择开启用药提醒。</view>
        <view class="elder-empty-btn" bindtap="goAddMedicine">去录入药品</view>
      </view>
    </block>

    <!-- ===== 阶段 3：有提醒 ===== -->
    <block wx:else>
      <view wx:if="{{isAdminView && duplicateCount > 0}}" class="elder-repair-notice">
        <view><view class="elder-repair-title">提醒数据需要整理</view><view class="elder-repair-desc">发现 {{duplicateCount}} 条旧版重复提醒，已完成历史不会受影响。</view></view>
        <view class="elder-repair-btn" bindtap="repairDuplicates">整理提醒</view>
      </view>
      <!-- 提醒列表 -->
      <view class="elder-section-title">当前待服</view>

      <view wx:if="{{reminders.length === 0}}" class="elder-period-empty">当前没有需要确认的药，下一次提醒会按设定时间出现。</view>

      <view
        class="elder-card {{item.status === 'overdue' ? 'is-overdue' : ''}}"
        wx:for="{{reminders}}"
        wx:key="id"
      >
        <view class="elder-time-box">
          <view class="elder-time">{{item.time}}</view>
          <view class="elder-time-dot"></view>
        </view>

        <view class="elder-main">
          <view class="elder-med">
            <view class="elder-med-icon">{{item.icon}}</view>
            <view class="elder-med-info">
              <view class="elder-med-name">{{item.medicineName}}</view>
              <view class="elder-med-meta">
                <text class="elder-for">{{item.memberName}}</text>
                <text class="elder-dose">{{item.dosage}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{item.status === 'overdue'}}" class="elder-overdue-label">已超过提醒时间</view>
          <block wx:if="{{item.actionable}}">
            <view class="elder-btns">
              <view class="elder-btn elder-btn-take {{processingRecordId ? 'is-disabled' : ''}}" catchtap="onTake" data-id="{{item.id}}">{{processingRecordId === item.id ? '正在记录…' : '已服用'}}</view>
              <view class="elder-btn elder-btn-later {{processingRecordId ? 'is-disabled' : ''}}" catchtap="onLater" data-id="{{item.id}}">10分钟后</view>
            </view>
          </block>
        </view>
      </view>

      <view wx:if="{{upcomingReminders.length}}" class="elder-group-toggle" bindtap="toggleUpcoming">
        <text>今日稍后（{{upcomingReminders.length}}）</text>
        <text>{{showUpcoming ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showUpcoming}}">
        <view class="elder-compact-card" wx:for="{{upcomingReminders}}" wx:key="id">
          <view class="elder-compact-time">{{item.time}}</view>
          <view class="elder-compact-main">
            <view class="elder-compact-name">{{item.medicineName}} · {{item.dosage}}</view>
            <view class="elder-compact-desc">{{item.displayHint}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{completedReminders.length}}" class="elder-group-toggle is-completed" bindtap="toggleCompleted">
        <text>今日已处理（{{completedReminders.length}}）</text>
        <text>{{showCompleted ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showCompleted}}">
        <view class="elder-compact-card is-completed" wx:for="{{completedReminders}}" wx:key="id">
          <view class="elder-compact-time">{{item.time}}</view>
          <view class="elder-compact-main">
            <view class="elder-compact-name">{{item.medicineName}} · {{item.dosage}}</view>
            <view class="elder-compact-desc">{{item.statusLabel}}</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 底部说明（所有阶段都展示） -->
    <view class="elder-tip-box">
      <view class="elder-tip-title">💚 温馨提示</view>
      <view class="elder-tip-desc">
        有任何问题请联系家人。药无忧只做家庭药品库存、有效期、提醒和补货管理，不提供用药建议，具体请遵医嘱。
      </view>
    </view>
  </view>
</view>
