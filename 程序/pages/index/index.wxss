/* pages/index/index.wxss */

.hero {
  position: relative;
  padding: 32rpx 32rpx 40rpx;
  color: #ffffff;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1f5a4d 0%, #2e7d6a 45%, #4db69d 100%);
  z-index: 0;
}

.hero-bg::after {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.hero-family {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-family-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  backdrop-filter: blur(10rpx);
}

.hero-family-name {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-family-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.hero-date {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 100rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.hero-date-icon {
  font-size: 26rpx;
}

/* 数据卡片 */
.stats {
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #ffffff;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.15s ease;
}

.quick-item:active {
  transform: scale(0.96);
  background: var(--surface-alt);
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-add .quick-icon    { background: linear-gradient(135deg, #4db69d, #2e7d6a); }
.quick-box .quick-icon    { background: linear-gradient(135deg, #5dade2, #3498db); }
.quick-family .quick-icon { background: linear-gradient(135deg, #f4a896, #e07a5f); }
.quick-elder .quick-icon  { background: linear-gradient(135deg, #f9d77e, #f39c12); }

.quick-label {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
}

/* 今日关注列表 */
.attention-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-radius: var(--radius);
  margin-bottom: 18rpx;
  gap: 20rpx;
  transition: all 0.15s ease;
}

.attention-item:active {
  opacity: 0.75;
}

.attention-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.attention-content {
  flex: 1;
  min-width: 0;
}

.attention-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.attention-type {
  font-size: 20rpx;
  padding: 3rpx 14rpx;
  border-radius: 100rpx;
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-light);
  font-weight: 600;
}

.attention-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.attention-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.attention-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  font-weight: 300;
  flex-shrink: 0;
}

/* 温馨提示 */
.tip-box {
  background: linear-gradient(135deg, #eafaf1, #f7faf8);
  border: 1rpx solid #c8e5d7;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.tip-icon {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 6rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.7;
}

/* 同步提示框（第四阶段新增） */
.sync-tip-box {
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, #eef5f1, #ffffff);
  border: 1rpx solid #a9d5bd;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
}
.sync-tip-icon {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(46, 125, 106, 0.08);
}
.sync-tip-content { flex: 1; min-width: 0; }
.sync-tip-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #276754;
  margin-bottom: 4rpx;
}
.sync-tip-desc {
  font-size: 24rpx;
  color: #4a655e;
  line-height: 1.55;
}
