/* pages/index/index.wxss */

.hero {
  position: relative;
  padding: 32rpx 32rpx 40rpx;
  color: #ffffff;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--gradient-brand);
  z-index: 0;
}

.hero-bg::after {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: var(--gradient-hero-glow);
  border-radius: 50%;
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.hero-family {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-family-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  backdrop-filter: blur(10rpx);
}

.hero-family-name {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-family-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.hero-date {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 100rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.hero-date-icon {
  font-size: 26rpx;
}

/* 数据卡片 */
.stats {
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #ffffff;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  background: var(--surface);
  border-radius: var(--radius-card);
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.15s ease;
}

.quick-item:active {
  transform: scale(0.96);
  background: var(--surface-alt);
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-add .quick-icon    { background: var(--gradient-primary-action); }
.quick-box .quick-icon    { background: var(--gradient-info); }
.quick-family .quick-icon { background: var(--gradient-family); }
.quick-elder .quick-icon  { background: linear-gradient(135deg, #f9d77e, var(--color-warning-500)); }

.quick-label {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
}

/* 今日关注列表 */
.attention-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-radius: var(--radius);
  margin-bottom: 18rpx;
  gap: 20rpx;
  transition: all 0.15s ease;
}

.attention-item:active {
  opacity: 0.75;
}

.attention-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.attention-content {
  flex: 1;
  min-width: 0;
}

.attention-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.attention-type {
  font-size: 20rpx;
  padding: 3rpx 14rpx;
  border-radius: 100rpx;
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-light);
  font-weight: 600;
}

.attention-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.attention-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.attention-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  font-weight: 300;
  flex-shrink: 0;
}

/* 温馨提示 */
.tip-box {
  background: var(--gradient-success);
  border: 1rpx solid #c8e5d7;
  border-radius: var(--radius-card);
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.tip-icon {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 6rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.7;
}

/* 同步提示框（第四阶段新增） */
.sync-tip-box {
  margin-bottom: 28rpx;
  background: var(--gradient-brand-soft);
  border: 1rpx solid #a9d5bd;
  border-radius: var(--radius-card);
  padding: 20rpx 24rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
}
.sync-tip-icon {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(46, 125, 106, 0.08);
}
.sync-tip-content { flex: 1; min-width: 0; }
.sync-tip-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 4rpx;
}
.sync-tip-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.55;
}

/* ---------- 空状态引导：无家庭 & 空药箱 ---------- */
.hero-inner-empty {
  padding: 24rpx 12rpx 8rpx;
  text-align: center;
}
.empty-hero-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}
.empty-hero-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 14rpx;
}
.empty-hero-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.7;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}
.empty-hero-btns {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: center;
  justify-content: center;
}
.btn-primary,
.btn-secondary {
  min-width: 440rpx;
  max-width: 82%;
  padding: 22rpx 40rpx;
  border-radius: var(--radius-pill);
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}
.btn-primary {
  background: #ffffff;
  color: #1f5a4d;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.08);
}
.btn-secondary {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}
.btn-primary:active {
  transform: scale(0.98);
  background: #f2faf7;
}
.btn-secondary:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.22);
}
/* 空药箱专用空态样式 */
.empty-empty-state {
  background: var(--surface);
  border: 1rpx dashed #b4d9c9;
  border-radius: var(--radius-card);
  padding: 56rpx 32rpx 44rpx;
  text-align: center;
}
.empty-empty-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}
.empty-empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 10rpx;
}
.empty-empty-desc {
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.7;
  margin-bottom: 28rpx;
  padding: 0 16rpx;
}
/* 空态按钮在白底容器里，颜色反一下 */
.empty-empty-state .btn-primary {
  background: var(--gradient-primary-action);
  color: #ffffff;
}
.empty-empty-state .btn-secondary {
  background: #f4fbf8;
  color: #1f5a4d;
  border: 1rpx solid #b4d9c9;
  backdrop-filter: none;
}
.monthly-audit-card { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; padding: 24rpx; border: 1rpx solid #f1cf76; border-radius: 8rpx; background: #fff8e1; }
.monthly-audit-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; color: #fff; background: #d4a017; font-weight: 900; }
.monthly-audit-main { flex: 1; min-width: 0; }.monthly-audit-title { font-size: 28rpx; font-weight: 900; color: var(--text); }.monthly-audit-desc { margin-top: 5rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-light); }.monthly-audit-arrow { font-size: 40rpx; color: #b9770e; }
