.audit-page { min-height: 100vh; background: var(--app-bg); }
.audit-hero { padding: 46rpx 36rpx 54rpx; color: #fff; background: var(--gradient-brand); }
.audit-title { font-size: 40rpx; font-weight: 900; }
.audit-subtitle { margin-top: 10rpx; font-size: 25rpx; opacity: .9; }
.audit-progress { display: flex; align-items: center; justify-content: space-between; margin-top: -24rpx; padding: 26rpx; }
.audit-settings { margin-top: -24rpx; margin-bottom: 20rpx; padding: 26rpx; }.audit-settings-title { font-size: 30rpx; font-weight: 900; }.audit-setting-row { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; font-size: 26rpx; }.audit-setting-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 18rpx; }.audit-setting-label { margin-bottom: 8rpx; color: var(--text-light); font-size: 22rpx; }.audit-setting-grid input,.audit-setting-picker { height: 72rpx; line-height: 72rpx; padding: 0 18rpx; border-radius: 8rpx; background: var(--surface-alt); box-sizing: border-box; }.audit-setting-save { margin: 18rpx 0 0; color: #fff; background: var(--primary); font-size: 25rpx; }
.audit-subscribe { margin-top: 20rpx; color: var(--primary-dark); font-size: 24rpx; font-weight: 800; text-align: center; }
.audit-period { font-size: 30rpx; font-weight: 900; }
.audit-count { color: var(--primary-dark); font-size: 24rpx; font-weight: 800; }
.audit-item { margin-top: 20rpx; padding: 26rpx; }
.audit-item-head { display: flex; justify-content: space-between; gap: 20rpx; }
.audit-med-name { font-size: 30rpx; font-weight: 900; color: var(--text); }
.audit-batch { margin-top: 6rpx; font-size: 22rpx; color: var(--text-light); }
.audit-status { color: #b9770e; font-size: 22rpx; }.audit-status.done { color: var(--primary-dark); }
.audit-quantity-row { display: grid; grid-template-columns: 1fr 44rpx 1fr; align-items: center; gap: 8rpx; margin-top: 24rpx; padding: 20rpx; background: var(--surface-alt); border-radius: 8rpx; text-align: center; }
.audit-number { display: block; font-size: 36rpx; font-weight: 900; }.audit-unit { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--text-light); }
.audit-input { width: 100%; height: 62rpx; border-bottom: 2rpx solid var(--primary); font-size: 34rpx; font-weight: 900; text-align: center; }
.audit-arrow { color: var(--text-lighter); }.audit-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 20rpx; }
.audit-actions button { margin: 0; font-size: 25rpx; background: var(--surface-alt); }.audit-actions .primary { color: #fff; background: var(--primary); }
.audit-complete { margin: 30rpx 0 60rpx; color: #fff; background: var(--gradient-brand); border-radius: 999rpx; font-weight: 900; }
