<!--pages/medicine-detail/medicine-detail.wxml  第六阶段：真实数据 + 空态处理-->
<view class="empty-page" wx:if="{{noFamily}}">
  <view class="empty-card">
    <view class="empty-icon">🏠</view>
    <view class="empty-title">请先创建家庭药箱</view>
    <view class="empty-desc">创建家庭后才能查看药品详情。</view>
    <view class="btn btn-primary btn-block" bindtap="goCreateFamily">去创建家庭</view>
  </view>
</view>

<view class="empty-page" wx:elif="{{notFound}}">
  <view class="empty-card">
    <view class="empty-icon">📭</view>
    <view class="empty-title">未找到该药品</view>
    <view class="empty-desc">可能已被删除，或需要先重置本地数据后再查看。</view>
    <view class="btn btn-primary btn-block" bindtap="goBackMedicines">返回药箱</view>
  </view>
</view>

<view class="page" wx:elif="{{medicine}}">

  <!-- 顶部药品卡片 -->
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-inner">
      <view class="hero-row">
        <view class="med-big-cover">
          <image wx:if="{{medicine.coverImage}}" class="med-big-cover-img" src="{{medicine.coverImage}}" mode="aspectFill"></image>
          <view wx:else class="med-big-cover-placeholder">
            <text>{{medicine.coverText}}</text>
            <text class="med-big-cover-sub">药品</text>
          </view>
        </view>
        <view class="hero-main">
          <view class="med-name">{{medicine.name}}</view>
          <view class="med-meta-row">
            <text class="hero-tag" style="background: {{summary.statusColor}}33; color: #fff;">
              {{summary.statusLabel}}
            </text>
            <text class="hero-tag hero-tag-alt">{{medicine.category}}</text>
            <text wx:if="{{summary.needRestock}}" class="hero-tag hero-tag-restock">建议补货</text>
          </view>
        </view>
      </view>

      <view class="hero-stats">
        <view class="hero-stat">
          <view class="hero-stat-num">{{summary.availableStock}}</view>
          <view class="hero-stat-label">可用库存</view>
        </view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{summary.batchCount}}</view>
          <view class="hero-stat-label">批次数量</view>
        </view>
        <view class="hero-stat">
          <view class="hero-stat-num small">{{summary.nearestExpire}}</view>
          <view class="hero-stat-label">最近有效期</view>
        </view>
        <view class="hero-stat">
          <view class="hero-stat-num {{summary.needRestock ? 'num-warn' : ''}}">
            {{summary.needRestock ? '是' : '否'}}
          </view>
          <view class="hero-stat-label">建议补货</view>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <view class="container">

    <!-- ================= 基础信息 tab ================= -->
    <block wx:if="{{activeTab === 'info'}}">
      <view class="card">
        <view class="card-title">📋 药品主档</view>
        <view class="info-row">
          <view class="info-label">药品名称</view>
          <view class="info-value">{{medicine.name}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">通用名</view>
          <view class="info-value">{{medicine.genericName || medicine.name}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">规格</view>
          <view class="info-value">{{medicine.specification}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">生产厂家</view>
          <view class="info-value">{{medicine.manufacturer || '未填写'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">类别</view>
          <view class="info-value">
            <text class="tag tag-primary">{{medicine.category}}</text>
          </view>
        </view>
        <view class="info-row">
          <view class="info-label">商品条码</view>
          <view class="info-value mono">{{medicine.barcode || '未填写'}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">适用成员</view>
          <view class="info-value">
            <text class="tag tag-accent">👤 {{forMemberText}}</text>
          </view>
        </view>
        <view class="info-row">
          <view class="info-label">存放位置</view>
          <view class="info-value">
            <text class="tag tag-info">📍 {{medicine.storageLocation}}</text>
          </view>
        </view>
        <view class="info-row">
          <view class="info-label">汇总状态</view>
          <view class="info-value">
            <text class="tag" style="background: {{summary.statusColor}}22; color: {{summary.statusColor}};">
              {{summary.statusLabel}}
            </text>
          </view>
        </view>
      </view>

      <view class="tip-box warn-tip">
        <view class="tip-icon">💚</view>
        <view class="tip-main">
          <view class="tip-title">安全说明</view>
          <view class="tip-desc">
            药无忧仅做家庭药品库存、有效期、服用提醒与补货管理；本页面字段不构成用药建议，具体剂量、服用时间请遵医嘱。
          </view>
        </view>
      </view>

      <view class="btn-row">
        <button wx:if="{{canEdit}}" class="btn btn-outline btn-block" bindtap="goEdit">编辑药品主档</button>
        <button wx:if="{{canEdit}}" class="btn btn-primary btn-block mt-16" bindtap="goSetReminder">配置用药提醒</button>
      </view>
    </block>

    <!-- ================= 批次库存 tab ================= -->
    <block wx:if="{{activeTab === 'batch'}}">
      <view class="card card-header-card">
        <view class="card-header">
          <view>
            <view class="card-title" style="margin-bottom: 4rpx;">批次库存（{{batches.length}}）</view>
            <view class="text-sm text-muted">
              排序：未过期批次在前，越早过期越靠前；已过期靠后；停用批次最后。
            </view>
          </view>
          <view wx:if="{{canEdit}}" class="mini-btn" bindtap="goAddBatch">+ 新增批次</view>
        </view>
      </view>

      <block wx:if="{{batches.length > 0}}">
        <view
          class="batch-card {{item.disabled ? 'is-disabled' : ''}}"
          wx:for="{{batches}}"
          wx:key="id"
          data-batch="{{item}}"
          style="border-left: 6rpx solid {{item.batchBorderColor}};"
        >
          <!-- 批次头部 -->
          <view class="batch-top">
            <view class="batch-title">
              批次号 <text class="batch-no">{{item.batchNo}}</text>
            </view>
            <view class="row" style="gap: 12rpx;">
              <text
                class="tag"
                style="background: {{item.statusColor}}22; color: {{item.statusColor}};"
              >{{item.statusLabel}}</text>
              <text
                wx:if="{{item.disabled}}"
                class="tag tag-muted"
              >已停用</text>
            </view>
          </view>

          <!-- 批次信息 2x2 网格 -->
          <view class="batch-grid">
            <view class="batch-cell">
              <view class="batch-k">生产日期</view>
              <view class="batch-v">{{item.productionDate}}</view>
            </view>
            <view class="batch-cell">
              <view class="batch-k">有效期至</view>
              <view class="batch-v {{item.status === 'expired' ? 'text-danger' : (item.status === 'nearExpire' ? 'text-warning' : '')}}">
                {{item.expireDate}}
                <text class="text-sm text-muted">（{{item.expireDaysText}}）</text>
              </view>
            </view>
            <view class="batch-cell">
              <view class="batch-k">总数 / 剩余</view>
              <view class="batch-v text-primary">
                {{item.remainingQuantity}} / {{item.totalQuantity}} {{item.unit}}
              </view>
            </view>
            <view class="batch-cell">
              <view class="batch-k">存放位置</view>
              <view class="batch-v">{{item.storageLocation}}</view>
            </view>
          </view>

          <!-- 剩余数量进度条 -->
          <view class="batch-progress-wrap">
            <view class="batch-progress-label">
              <text>剩余占比</text>
              <text class="text-muted text-sm">{{item.remainPercent}}%</text>
            </view>
            <view class="batch-progress">
              <view
                class="batch-progress-bar"
                style="{{item.progressStyle}}"
              ></view>
            </view>
          </view>

          <!-- 识别来源 + 置信度 + 日期来源标注 -->
          <view class="batch-meta-card">
            <view class="batch-meta-row">
              <view class="batch-meta-item">
                <text class="batch-meta-k">📥 数据来源：</text>
                <text class="tag tag-info">{{item.sourceLabel}}</text>
              </view>
              <view class="batch-meta-item">
                <text class="batch-meta-k">🎯 识别置信度：</text>
                <text class="batch-meta-v {{item.confidencePercent < 90 ? 'text-warning' : 'text-success'}}">
                  {{item.confidencePercent}}%
                </text>
              </view>
            </view>
            <view class="batch-source-note">
              🗒️ 日期来源标注：{{item.imageSourceNote}}
            </view>
          </view>

          <!-- 批次操作按钮 -->
          <view class="batch-op-row">
            <view wx:if="{{canEdit}}" class="batch-op batch-op-edit" data-id="{{item.id}}" bindtap="goEditBatch">编辑批次</view>
            <view class="batch-op batch-op-disable" data-id="{{item.id}}" bindtap="goDisableBatch">
              {{item.disabled ? '重新启用' : '停用批次'}}
            </view>
          </view>
        </view>
      </block>

      <view wx:else class="empty">
        <view class="empty-icon">📦</view>
        <view>暂无批次数据</view>
      </view>

      <!-- 批次使用提示文案（用户要求明确显示） -->
      <view class="tip-box main-tip mt-16">
        <view class="tip-icon">📌</view>
        <view class="tip-main">
          <view class="tip-title">使用规则</view>
          <view class="tip-desc">
            建议优先使用临期批次。系统默认先使用有效期更近的批次；已过期和已停用批次会被排除在可用库存与补货计算之外。
          </view>
        </view>
      </view>

      <view class="tip-box warn-tip mt-16">
        <view class="tip-icon">💚</view>
        <view class="tip-main">
          <view class="tip-title">安全说明</view>
          <view class="tip-desc">
            系统只做库存与提醒管理，不提供用药建议。过期药品请及时清理丢弃，是否可服用请遵医嘱。
          </view>
        </view>
      </view>
    </block>

    <!-- ================= 用药计划 tab ================= -->
    <block wx:if="{{activeTab === 'plan'}}">
      <view class="usage-forecast-card {{usageForecast.lowStock ? 'usage-forecast-warning' : ''}}">
        <view class="usage-forecast-title">预计用量</view>
        <block wx:if="{{usageForecast.calculable}}">
          <view class="usage-forecast-grid">
            <view><text class="usage-forecast-value">{{usageForecast.dailyUsage}}</text><text class="usage-forecast-unit">{{usageForecast.unit}}/天</text></view>
            <view><text class="usage-forecast-value">{{usageForecast.availableStock}}</text><text class="usage-forecast-unit">{{usageForecast.unit}}库存</text></view>
            <view><text class="usage-forecast-value">{{usageForecast.daysRemaining}}</text><text class="usage-forecast-unit">天可用</text></view>
          </view>
          <view class="usage-forecast-desc">预计用完：{{usageForecast.runoutDate}}{{usageForecast.lowStock ? ' · 建议及时补充' : ''}}</view>
        </block>
        <view wx:else class="usage-forecast-desc">{{usageForecast.reason}}</view>
      </view>
      <view class="card card-header-card">
        <view class="card-header">
          <view>
            <view class="card-title" style="margin-bottom: 4rpx;">用药计划（{{medicationPlans.length}}）</view>
            <view class="text-sm text-muted">仅记录家庭提醒，不提供剂量建议。</view>
          </view>
          <view wx:if="{{canEdit}}" class="mini-btn" bindtap="goSetReminder">+ 新建计划</view>
        </view>
      </view>

      <view wx:if="{{!canEdit}}" class="app-notice-info plan-readonly-notice">当前账号只有查看权限，用药计划由管理员或获授权成员维护。</view>

      <block wx:if="{{medicationPlans.length > 0}}">
        <view
          wx:for="{{medicationPlans}}"
          wx:key="id"
          class="plan-card {{item.enabled === false ? 'is-disabled' : ''}}"
        >
          <view class="plan-top">
            <view>
              <view class="plan-title">{{item.memberName}} · {{item.dosePerTime}}</view>
              <view class="plan-subtitle">每天 {{item.timesPerDay}} 次 · {{item.timesText}}</view>
            </view>
            <text class="tag {{item.enabled === false ? 'tag-muted' : 'tag-primary'}}">{{item.enabledLabel}}</text>
          </view>
          <view class="plan-grid">
            <view class="plan-cell">
              <view class="plan-k">开始日期</view>
              <view class="plan-v">{{item.startDate || '今天'}}</view>
            </view>
            <view class="plan-cell">
              <view class="plan-k">结束日期</view>
              <view class="plan-v">{{item.endDate || '长期'}}</view>
            </view>
            <view class="plan-cell">
              <view class="plan-k">家人确认</view>
              <view class="plan-v">{{item.needGuardianConfirm ? '需要' : '不需要'}}</view>
            </view>
            <view class="plan-cell">
              <view class="plan-k">备注</view>
              <view class="plan-v">{{item.note || '无'}}</view>
            </view>
          </view>
          <view class="plan-op-row">
            <view wx:if="{{canEdit}}" class="batch-op batch-op-edit" data-id="{{item.id}}" bindtap="openPlanEditor">编辑计划</view>
            <view wx:if="{{canEdit}}" class="batch-op batch-op-disable" data-id="{{item.id}}" bindtap="togglePlanEnabled">
              {{item.enabled === false ? '启用计划' : '停用计划'}}
            </view>
          </view>
        </view>
      </block>

      <view wx:else class="card">
        <view class="placeholder compact-placeholder">
          <view class="placeholder-icon">⏰</view>
          <view class="placeholder-title">还没有用药计划</view>
          <view class="placeholder-desc">
            可以为这个药品设置每日提醒，老人端会显示大字提醒并支持确认服用。
          </view>
          <button wx:if="{{canEdit}}" class="btn btn-primary mt-24" bindtap="goSetReminder">去配置用药计划</button>
        </view>
      </view>

      <view class="tip-box warn-tip mt-16">
        <view class="tip-icon">💚</view>
        <view class="tip-main">
          <view class="tip-title">安全说明</view>
          <view class="tip-desc">药无忧不推荐剂量、不判断疗效，具体用法用量请在医生或药师指导下使用。</view>
        </view>
      </view>
    </block>

  </view>

  <!-- 药品主档编辑弹层 -->
  <view wx:if="{{showMasterEditor}}" class="editor-mask" bindtap="closeMasterEditor">
    <view class="editor-panel" catchtap="noop">
      <view class="editor-head">
        <view>
          <view class="editor-title">编辑药品主档</view>
          <view class="editor-subtitle">保存后药箱列表和首页统计会同步刷新</view>
        </view>
        <view class="editor-close" bindtap="closeMasterEditor">×</view>
      </view>

      <view class="cover-editor">
        <view class="cover-preview" bindtap="chooseMasterCover">
          <image wx:if="{{masterDraft.coverImage}}" class="cover-preview-img" src="{{masterDraft.coverImage}}" mode="aspectFill"></image>
          <view wx:else class="cover-preview-empty">
            <text class="cover-preview-plus">+</text>
            <text>药盒照片</text>
          </view>
        </view>
        <view class="cover-actions">
          <view class="app-form-helper">图片仅用于家庭识别药品，不作为医疗判断依据。</view>
          <view class="cover-action-row">
            <button class="mini-outline" bindtap="chooseMasterCover">重选照片</button>
            <button wx:if="{{masterDraft.coverImage}}" class="mini-danger" bindtap="removeMasterCover">移除</button>
          </view>
        </view>
      </view>

      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 药品名称</view>
        <input class="app-form-input" value="{{masterDraft.name}}" data-field="name" bindinput="onMasterInput" placeholder="例如：清火片" />
      </view>
      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 规格</view>
        <input class="app-form-input" value="{{masterDraft.specification}}" data-field="specification" bindinput="onMasterInput" placeholder="例如：40片/盒" />
      </view>
      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 类别</view>
        <view class="app-option-row">
          <view
            wx:for="{{categoryOptions}}"
            wx:key="*this"
            class="app-option-chip {{masterDraft.category === item ? 'app-option-chip-active' : ''}}"
            data-value="{{item}}"
            bindtap="chooseMasterCategory"
          >{{item}}</view>
        </view>
        <input class="app-form-input mt-12" value="{{masterDraft.category}}" data-field="category" bindinput="onMasterInput" placeholder="也可以手动输入类别" />
      </view>
      <view class="app-form-field">
        <view class="app-form-label">厂家</view>
        <input class="app-form-input" value="{{masterDraft.manufacturer}}" data-field="manufacturer" bindinput="onMasterInput" placeholder="例如：某某制药有限公司" />
      </view>
      <view class="app-form-field">
        <view class="app-form-label">条码</view>
        <input class="app-form-input" value="{{masterDraft.barcode}}" data-field="barcode" bindinput="onMasterInput" placeholder="可扫码后自动带入，也可手动填写" />
      </view>
      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 使用人</view>
        <input class="app-form-input" value="{{masterDraft.targetMemberLabel}}" data-field="targetMemberLabel" bindinput="onMasterInput" placeholder="例如：全家备用、爸爸、李鑫" />
      </view>
      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 存放位置</view>
        <view class="app-option-row">
          <view
            wx:for="{{locationOptions}}"
            wx:key="*this"
            class="app-option-chip {{masterDraft.storageLocation === item ? 'app-option-chip-active' : ''}}"
            data-value="{{item}}"
            bindtap="chooseMasterLocation"
          >{{item}}</view>
        </view>
        <input class="app-form-input mt-12" value="{{masterDraft.storageLocation}}" data-field="storageLocation" bindinput="onMasterInput" placeholder="也可以手动输入位置" />
      </view>
      <view wx:if="{{masterError}}" class="app-form-error">{{masterError}}</view>
      <view class="editor-actions">
        <button class="editor-btn editor-btn-ghost" bindtap="closeMasterEditor">取消</button>
        <button class="editor-btn editor-btn-primary" bindtap="saveMasterDraft">保存主档</button>
      </view>
    </view>
  </view>

  <!-- 批次新增/编辑弹层 -->
  <view wx:if="{{showBatchEditor}}" class="editor-mask" bindtap="closeBatchEditor">
    <view class="editor-panel" catchtap="noop">
      <view class="editor-head">
        <view>
          <view class="editor-title">{{batchEditorMode === 'edit' ? '编辑批次' : '新增批次'}}</view>
          <view class="editor-subtitle">批次变化会影响库存、临期和首页统计</view>
        </view>
        <view class="editor-close" bindtap="closeBatchEditor">×</view>
      </view>

      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 有效期</view>
        <picker mode="date" value="{{batchDraft.expireDate}}" data-field="expireDate" bindchange="onBatchDateChange">
          <view class="app-form-picker">{{batchDraft.expireDate || '请选择有效期'}}</view>
        </picker>
      </view>
      <view class="form-two-col">
        <view class="app-form-field">
          <view class="app-form-label"><text class="app-form-required">*</text> 总数量</view>
          <input class="app-form-input" type="digit" value="{{batchDraft.totalQuantity}}" data-field="totalQuantity" bindinput="onBatchInput" placeholder="例如：20" />
        </view>
        <view class="app-form-field">
          <view class="app-form-label"><text class="app-form-required">*</text> 剩余数量</view>
          <input class="app-form-input" type="digit" value="{{batchDraft.remainingQuantity}}" data-field="remainingQuantity" bindinput="onBatchInput" placeholder="例如：18" />
        </view>
      </view>
      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 单位</view>
        <view class="app-option-row">
          <view
            wx:for="{{unitOptions}}"
            wx:key="*this"
            class="app-option-chip {{batchDraft.unit === item ? 'app-option-chip-active' : ''}}"
            data-value="{{item}}"
            bindtap="chooseBatchUnit"
          >{{item}}</view>
        </view>
        <input class="app-form-input mt-12" value="{{batchDraft.unit}}" data-field="unit" bindinput="onBatchInput" placeholder="也可以手动输入单位" />
      </view>
      <view class="form-two-col">
        <view class="app-form-field">
          <view class="app-form-label">批号</view>
          <input class="app-form-input" value="{{batchDraft.batchNo}}" data-field="batchNo" bindinput="onBatchInput" placeholder="不填自动生成" />
        </view>
        <view class="app-form-field">
          <view class="app-form-label">生产日期</view>
          <picker mode="date" value="{{batchDraft.productionDate}}" data-field="productionDate" bindchange="onBatchDateChange">
            <view class="app-form-picker">{{batchDraft.productionDate || '可选'}}</view>
          </picker>
        </view>
      </view>
      <view class="app-form-field">
        <view class="app-form-label">备注</view>
        <textarea class="app-form-textarea compact-textarea" value="{{batchDraft.note}}" data-field="note" bindinput="onBatchInput" placeholder="例如：外盒已拆、药板剩余数量已核对"></textarea>
      </view>
      <view class="app-form-field">
        <view class="app-form-label">日期来源说明</view>
        <input class="app-form-input" value="{{batchDraft.imageSourceNote}}" data-field="imageSourceNote" bindinput="onBatchInput" placeholder="例如：手动查看外盒喷码" />
      </view>
      <view wx:if="{{batchError}}" class="app-form-error">{{batchError}}</view>
      <view class="editor-actions">
        <button class="editor-btn editor-btn-ghost" bindtap="closeBatchEditor">取消</button>
        <button class="editor-btn editor-btn-primary" bindtap="saveBatchDraft">保存批次</button>
      </view>
    </view>
  </view>

  <!-- 用药计划编辑弹层 -->
  <view wx:if="{{showPlanEditor}}" class="editor-mask" bindtap="closePlanEditor">
    <view class="editor-panel" catchtap="noop">
      <view class="editor-head">
        <view>
          <view class="editor-title">{{planEditorMode === 'edit' ? '编辑用药计划' : '新建用药计划'}}</view>
          <view class="editor-subtitle">提醒内容由家人手动填写，系统不推荐剂量。</view>
        </view>
        <view class="editor-close" bindtap="closePlanEditor">×</view>
      </view>

      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 使用人</view>
        <view class="app-option-row">
          <view
            wx:for="{{memberOptions}}"
            wx:key="id"
            class="app-option-chip {{planDraft.memberId === item.id ? 'app-option-chip-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="choosePlanMember"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 每次用量</view>
        <input class="app-form-input" type="digit" value="{{planDraft.doseQuantity}}" data-field="doseQuantity" bindinput="onPlanInput" placeholder="例如：1、0.5、5" />
        <view class="app-option-row mt-12">
          <view wx:for="{{unitOptions}}" wx:key="*this" class="app-option-chip {{planDraft.doseUnit === item ? 'app-option-chip-active' : ''}}" data-value="{{item}}" bindtap="choosePlanDoseUnit">{{item}}</view>
        </view>
        <view class="app-form-helper">请按医生或药师要求填写，药无忧不判断剂量是否合理。</view>
      </view>

      <view class="switch-row">
        <view>
          <view class="switch-title">确认服药后扣减库存</view>
          <view class="switch-desc">按有效期更近的批次优先扣减，跳过提醒不会扣库存。</view>
        </view>
        <switch checked="{{planDraft.deductStock}}" bindchange="onPlanDeductChange" color="#2e7d6a" />
      </view>

      <view class="subscribe-entry {{subscriptionConfigured ? '' : 'is-disabled'}}" bindtap="requestMedicationSubscription">
        <view><view class="switch-title">微信订阅提醒</view><view class="switch-desc">{{subscriptionConfigured ? '获得授权后，可在小程序外收到微信服务通知；小程序内提醒始终保留。' : '暂未开通；不影响小程序内的定点提醒。'}}</view></view>
        <view class="subscribe-entry-action">{{subscriptionConfigured ? '去授权 ›' : '暂未开通'}}</view>
      </view>

      <view class="app-form-field">
        <view class="app-form-label">提前多少天提示补充</view>
        <input class="app-form-input" type="number" value="{{planDraft.stockWarningDays}}" data-field="stockWarningDays" bindinput="onPlanInput" placeholder="默认 7 天" />
      </view>

      <view class="app-form-field">
        <view class="app-form-label"><text class="app-form-required">*</text> 提醒时间</view>
        <view
          wx:for="{{planDraft.reminderTimes}}"
          wx:key="*this"
          wx:for-index="idx"
          class="plan-time-row"
        >
          <picker mode="time" value="{{item}}" data-index="{{idx}}" bindchange="onPlanTimeChange">
            <view class="app-form-picker plan-time-picker">{{item || '请选择时间'}}</view>
          </picker>
          <view class="plan-time-remove" data-index="{{idx}}" bindtap="removePlanTime">移除</view>
        </view>
        <view class="mini-btn plan-add-time" bindtap="addPlanTime">+ 添加提醒时间</view>
      </view>

      <view class="form-two-col">
        <view class="app-form-field">
          <view class="app-form-label"><text class="app-form-required">*</text> 开始日期</view>
          <picker mode="date" value="{{planDraft.startDate}}" data-field="startDate" bindchange="onPlanDateChange">
            <view class="app-form-picker">{{planDraft.startDate || '请选择'}}</view>
          </picker>
        </view>
        <view class="app-form-field">
          <view class="app-form-label">结束日期</view>
          <picker mode="date" value="{{planDraft.endDate}}" data-field="endDate" bindchange="onPlanDateChange">
            <view class="app-form-picker">{{planDraft.endDate || '长期'}}</view>
          </picker>
        </view>
      </view>

      <view class="switch-row">
        <view>
          <view class="switch-title">需要家人确认</view>
          <view class="switch-desc">老人确认后，首页待确认数量会同步减少。</view>
        </view>
        <switch checked="{{planDraft.needGuardianConfirm}}" bindchange="onPlanConfirmChange" color="#2e7d6a" />
      </view>

      <view class="switch-row">
        <view>
          <view class="switch-title">启用计划</view>
          <view class="switch-desc">关闭后不会继续生成新的今日提醒。</view>
        </view>
        <switch checked="{{planDraft.enabled}}" bindchange="onPlanEnabledChange" color="#2e7d6a" />
      </view>

      <view class="app-form-field">
        <view class="app-form-label">备注</view>
        <textarea class="app-form-textarea compact-textarea" value="{{planDraft.note}}" data-field="note" bindinput="onPlanInput" placeholder="例如：饭后服用；具体请遵医嘱"></textarea>
      </view>

      <view wx:if="{{planError}}" class="app-form-error">{{planError}}</view>
      <view class="editor-actions">
        <button class="editor-btn editor-btn-ghost" bindtap="closePlanEditor">取消</button>
        <button class="editor-btn editor-btn-primary" loading="{{planSaving}}" disabled="{{planSaving}}" bindtap="savePlanDraft">{{planSaving ? '正在保存' : '保存计划'}}</button>
      </view>
    </view>
  </view>
</view>
