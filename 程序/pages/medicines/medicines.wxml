<!--pages/medicines/medicines.wxml  第六阶段：真实流程三种状态（无家庭 / 空药箱 / 有数据）-->
<view class="page">
  <!-- ===== 无家庭阶段：请先创建家庭 ===== -->
  <block wx:if="{{stage === 'noFamily'}}">
    <view class="filter-bar filter-bar-blank">
      <view class="filter-info">
        <view class="filter-title">💊 家庭药箱</view>
        <view class="filter-sub">请先创建家庭，才能开始录入药品</view>
      </view>
    </view>
    <view class="container">
      <view class="empty-empty-state">
        <view class="empty-empty-icon">🏠</view>
        <view class="empty-empty-title">请先创建家庭药箱</view>
        <view class="empty-empty-desc">创建家庭后，你可以录入药品、管理有效期、并邀请家人一起查看。</view>
        <view class="empty-empty-btn" bindtap="goCreateFamily">去创建家庭</view>
      </view>
      <view class="safe-note mt-32">
        <text>📌 药无忧只做家庭药品库存、有效期、提醒和补货管理，不提供医疗诊断和用药建议。</text>
      </view>
    </view>
  </block>

  <!-- ===== 有家庭、无药品阶段 ===== -->
  <block wx:elif="{{stage === 'emptyMedicine'}}">
    <view class="filter-bar">
      <view class="filter-info">
        <view class="filter-title">💊 {{familyName}}</view>
        <view class="filter-sub">还没有录入药品，先添加第一盒药</view>
      </view>
    </view>
    <view class="container">
      <view class="empty-empty-state">
        <view class="empty-empty-icon">💊</view>
        <view class="empty-empty-title">还没有录入药品</view>
        <view class="empty-empty-desc">添加第一盒药后，可以管理有效期、批次和剩余数量。</view>
        <view class="empty-empty-btn" bindtap="goAddMedicine">添加药品</view>
      </view>
      <view class="safe-note mt-32">
        <text>📌 药无忧只做家庭药品库存、有效期、提醒和补货管理，不提供医疗诊断和用药建议。</text>
      </view>
    </view>
    <view class="add-floating" bindtap="goAddMedicine">
      <text class="add-floating-icon">+</text>
      <text class="add-floating-text">添加药品</text>
    </view>
  </block>

  <!-- ===== 有数据阶段：筛选 + 卡片列表 ===== -->
  <block wx:else>
    <view class="filter-bar">
      <view class="filter-info">
        <view class="filter-title">💊 {{familyName}}</view>
        <view class="filter-sub">
          共 {{totalCount}} 种药品 · 主档视图，批次详情请点进药品卡片
        </view>
      </view>
    </view>

    <!-- 1) 状态筛选 -->
    <view class="filter-row">
      <view class="filter-row-label">状态</view>
      <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="chip {{activeStatus === item.key ? 'chip-active' : ''}}"
          wx:for="{{filterGroups.statuses}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onStatusTap"
        >{{item.label}}</view>
      </scroll-view>
    </view>
    <!-- 2) 使用人筛选 -->
    <view class="filter-row">
      <view class="filter-row-label">使用人</view>
      <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="chip {{activeMember === item.key ? 'chip-active' : ''}}"
          wx:for="{{filterGroups.members}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onMemberTap"
        >{{item.label}}</view>
      </scroll-view>
    </view>
    <!-- 3) 类别筛选 -->
    <view class="filter-row">
      <view class="filter-row-label">类别</view>
      <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="chip {{activeCategory === item.key ? 'chip-active' : ''}}"
          wx:for="{{filterGroups.categories}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >{{item.label}}</view>
      </scroll-view>
    </view>
    <!-- 4) 位置筛选 -->
    <view class="filter-row filter-row-last">
      <view class="filter-row-label">位置</view>
      <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
        <view
          class="chip {{activeLocation === item.key ? 'chip-active' : ''}}"
          wx:for="{{filterGroups.locations}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onLocationTap"
        >{{item.label}}</view>
      </scroll-view>
      <view
        wx:if="{{activeStatus !== 'all' || activeMember !== 'all' || activeCategory !== 'all' || activeLocation !== 'all'}}"
        class="reset-btn"
        bindtap="onResetFilters"
      >重置</view>
    </view>

    <view class="container">
      <block wx:if="{{filteredCards.length > 0}}">
        <view
          class="med-card"
          wx:for="{{filteredCards}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail"
        >
          <view class="med-left">
            <view class="med-cover" style="background: {{item.coverColor}}18;">
              <image wx:if="{{item.coverImage}}" class="med-cover-image" src="{{item.coverImage}}" mode="aspectFill"></image>
              <view wx:else class="med-cover-empty" style="color: {{item.coverColor}};">
                <text class="med-cover-text">{{item.coverText}}</text>
                <text class="med-cover-sub">药品</text>
              </view>
            </view>
          </view>
          <view class="med-main">
            <view class="med-header">
              <view class="med-name">{{item.name}}</view>
              <view class="tag" style="background: {{item.statusColor}}18; color: {{item.statusColor}};">
                {{item.statusLabel}}
                <text wx:if="{{item.needRestock}}" class="restock-dot"> · 建议补货</text>
              </view>
            </view>
            <view class="med-meta-row">
              <text class="tag tag-primary">{{item.category || '未分类'}}</text>
              <text class="med-for">
                <text class="med-for-icon">👤</text>{{item.forMember || '未指定'}}
              </text>
              <text class="med-loc" wx:if="{{item.storageLocation}}">
                <text class="med-for-icon">📍</text>{{item.storageLocation}}
              </text>
            </view>
            <view class="med-footer">
              <view class="med-stats">
                <view class="med-stat">
                  <text class="med-stat-num text-primary">{{item.availableStock}}</text>
                  <text class="med-stat-label">可用库存</text>
                </view>
                <view class="med-stat">
                  <text class="med-stat-num">{{item.batchCount}}</text>
                  <text class="med-stat-label">批次数量</text>
                </view>
                <view class="med-stat">
                  <text class="med-stat-num med-stat-date {{item.status === 'nearExpire' ? 'text-warning' : (item.status === 'expired' ? 'text-danger' : 'text-light')}}">{{item.nearestExpire || '—'}}</text>
                  <text class="med-stat-label">最近有效期</text>
                </view>
              </view>
            </view>
          </view>
          <view class="med-arrow">›</view>
        </view>
      </block>

      <view wx:else class="empty">
        <view class="empty-icon">📭</view>
        <view>当前筛选条件下没有药品</view>
        <view class="text-sm text-muted mt-16">试试点击"重置"按钮恢复全部</view>
      </view>

      <view class="safe-note mt-24">
        <text>📌 药无忧只做家庭药品库存、有效期、提醒和补货管理，不提供医疗诊断和用药建议。</text>
      </view>
    </view>

    <view class="add-floating" bindtap="goAddMedicine">
      <text class="add-floating-icon">+</text>
      <text class="add-floating-text">添加药品</text>
    </view>
  </block>
</view>
