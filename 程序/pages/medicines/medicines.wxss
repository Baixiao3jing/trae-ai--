/* pages/medicines/medicines.wxss */

/* ============= 第二阶段新增：筛选器区域 ============= */
.filter-row {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
  padding: 16rpx 0 16rpx 32rpx;
}

.filter-row-last {
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
}

.filter-row-label {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  color: var(--text-light);
  font-weight: 600;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  background: var(--surface-alt);
  color: var(--text-light);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 14rpx;
  transition: all 0.15s ease;
}

.chip-active {
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 106, 0.24);
}

.reset-btn {
  flex-shrink: 0;
  margin: 0 24rpx 0 8rpx;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill);
  background: var(--danger-bg);
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 700;
}

/* ============= 卡片汇总信息 ============= */
.med-loc {
  font-size: 24rpx;
  color: var(--text-light);
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.restock-dot {
  font-size: 20rpx;
  opacity: 0.95;
}

.med-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.med-stat {
  min-width: 0;
  min-height: 108rpx;
  background: var(--surface-alt);
  border-radius: var(--radius-sm);
  padding: 12rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.med-stat-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.2;
  max-width: 100%;
  word-break: break-all;
}

.med-stat-date {
  font-size: 25rpx;
  line-height: 1.12;
}

.med-stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  font-weight: 600;
}

/* 底部安全提示 */
.safe-note {
  background: var(--gradient-warning);
  border: 1rpx solid #f4e2b8;
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.7;
}

.filter-bar {
  padding: 24rpx 32rpx 12rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}

.filter-info {
  display: block;
}

.filter-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.filter-sub {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  line-height: 1.5;
}

.filter-scroll {
  background: var(--surface);
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 8rpx;
}

.filter-scroll-inner {
  white-space: nowrap;
  padding: 0 24rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 28rpx;
  background: var(--surface-alt);
  color: var(--text-light);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
  transition: all 0.15s ease;
}

.filter-chip.active {
  background: var(--primary);
  color: #ffffff;
}

.filter-chip-count {
  opacity: 0.8;
  font-size: 22rpx;
}

/* 药品卡片 */
.med-card {
  background: var(--surface);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.15s ease;
}

.med-card:active {
  background: var(--surface-alt);
  transform: scale(0.99);
}

.med-left {
  flex-shrink: 0;
}

.med-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 106, 0.08);
}

.med-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.med-cover-empty {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(240,246,243,0.92));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.med-cover-text {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.med-cover-sub {
  font-size: 20rpx;
  color: var(--text-muted);
  font-weight: 700;
}

.med-main {
  flex: 1;
  min-width: 0;
}

.med-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.med-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.med-header .tag {
  flex-shrink: 0;
  max-width: 176rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.med-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 14rpx;
  min-height: 42rpx;
}

.med-for {
  font-size: 24rpx;
  color: var(--text-light);
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.med-for-icon {
  font-size: 22rpx;
}

.med-footer {
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--border);
}

.med-batch {
  font-size: 24rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.med-batch-icon {
  font-size: 22rpx;
}

.med-expire {
  font-size: 22rpx;
  color: var(--text-muted);
}

.med-arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  color: var(--text-muted);
  font-weight: 300;
  padding-left: 8rpx;
}

/* 底部浮动添加按钮 */
.add-floating {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 48rpx;
  background: var(--gradient-primary-action);
  color: #ffffff;
  padding: 22rpx 56rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-float);
  z-index: 100;
  transition: all 0.15s ease;
}

.add-floating:active {
  transform: translateX(-50%) scale(0.96);
}

.add-floating-icon {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.add-floating-text {
  font-size: 30rpx;
  font-weight: 700;
}

/* ---------- 第六阶段：药箱页空状态 ---------- */
.filter-bar-blank .filter-title { color: var(--text); }
.filter-bar-blank .filter-sub { color: var(--text-light); }
.empty-empty-state {
  background: var(--surface);
  border: 2rpx dashed #b4d9c9;
  border-radius: var(--radius-card);
  padding: 64rpx 32rpx 48rpx;
  text-align: center;
  margin-top: 32rpx;
}
.empty-empty-icon {
  font-size: 80rpx;
  margin-bottom: 14rpx;
}
.empty-empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 10rpx;
}
.empty-empty-desc {
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.7;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}
.empty-empty-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: var(--gradient-primary-action);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(46, 125, 106, 0.25);
}
.empty-empty-btn:active { transform: scale(0.98); }
