/* pages/privacy/privacy.wxss */

.privacy-hero {
  position: relative;
  padding: 44rpx 32rpx 80rpx;
  color: #fff;
  text-align: center;
  overflow: hidden;
}
.privacy-hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1f5a4d 0%, #2e7d6a 50%, #58c2a6 100%);
}
.privacy-hero-bg::after {
  content: '';
  position: absolute;
  top: -80rpx; left: 50%;
  width: 560rpx; height: 560rpx;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.privacy-hero-inner { position: relative; z-index: 1; }
.privacy-hero-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}
.privacy-hero-title {
  font-size: 40rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}
.privacy-hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.card-title-icon { font-size: 30rpx; }

/* 授权状态卡片 */
.auth-list {
  display: flex;
  flex-direction: column;
}
.auth-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}
.auth-item + .auth-item {
  border-top: 1rpx dashed var(--border);
}
.auth-icon {
  width: 68rpx;
  height: 68rpx;
  background: var(--surface-alt);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.auth-main { flex: 1; min-width: 0; }
.auth-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4rpx;
}
.auth-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
}
.auth-status {
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
  padding-left: 10rpx;
}

/* 信息卡片 */
.info-text {
  font-size: 26rpx;
  line-height: 1.85;
  color: #4a655e;
}
.info-text b {
  color: var(--primary-dark);
  font-weight: 800;
}
.info-warn {
  background: linear-gradient(135deg, #fff8e1, #fdf6ec);
  border-color: #f0d49c;
}
.info-warn .info-text {
  color: #6b5a2a;
}
.info-warn .info-text b {
  color: #8a5a15;
}

/* 导航卡片 */
.nav-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.nav-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.nav-main { flex: 1; min-width: 0; }
.nav-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 4rpx;
}
.nav-desc {
  font-size: 22rpx;
  color: var(--text-light);
}
.nav-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

/* 操作卡片 */
.action-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
  background: var(--surface-alt);
  transition: background 0.15s ease, transform 0.12s ease;
}
.action-item:last-child { margin-bottom: 0; }
.action-item:active {
  transform: scale(0.99);
  background: #e0ebe6;
}
.action-primary {
  background: linear-gradient(135deg, #eafaf1, #ffffff);
  border: 1rpx solid #b4ddc7;
}
.action-danger {
  background: linear-gradient(135deg, #fdecea, #fff);
  border: 1rpx solid #f5b7b1;
}
.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.action-main { flex: 1; min-width: 0; }
.action-label {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 4rpx;
}
.action-desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.4;
}

.bottom-space {
  height: 60rpx;
}
